# ShopPilot Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=true

# AI / Multimodal Vision LLM
# Provide your Google Gemini API key below. If left empty, ShopPilot operates in Smart Heuristic Vision mode.
GEMINI_API_KEY=your_gemini_api_key_here
VISION_MODEL_NAME=gemini-1.5-flash

# Browser Automation (Playwright)
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ACTION_DELAY_MS=800
MAX_STEPS=15
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Safety Guardrails (Prevents accidental real purchases)
ENABLE_PURCHASE_PREVENTION=true

# Notifications & Webhooks
WEBHOOK_URL=http://localhost:8000/api/webhook/mock

# Distributed Worker Queue (Redis & Celery)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# ─────────────────────────────────────────────────────────────
# Pluggable Store Connectors (Phase C)
# ─────────────────────────────────────────────────────────────
# Set USE_MOCK_DATA=true to run offline with zero external keys (315 products, 5 stores, 8 categories)
USE_MOCK_DATA=true
PRIMARY_CONNECTOR=mock

# Amazon Product Advertising API (PA-API v5)
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_REGION=in

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Generic Merchant Feed Importer (CSV / XML / RSS)
MERCHANT_FEED_URL=
MERCHANT_FEED_PATH=

# Email & Price-Drop Alerts (SMTP with console fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@shoppilot.com

# Telegram Alerts (Phase F)
# Obtain token from @BotFather on Telegram. If empty, falls back to console logging.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ShopPilotAlertsBot
