# ShopPilot Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=true
ENVIRONMENT=production

# Database (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://shoppilot_user:shoppilot_secure_password@localhost:5432/shoppilot

# Frontend Origin for strict CORS
FRONTEND_URL=http://localhost:3000

# Admin Secret Key (protects /api/admin/* endpoints)
ADMIN_SECRET_KEY=shoppilot-admin-secret-2026

# AI / Multimodal Vision LLM
# Provide your Google Gemini API key below. If left empty, ShopPilot operates in Smart Heuristic mode.
GEMINI_API_KEY=
VISION_MODEL_NAME=gemini-1.5-flash

# Pluggable Store Connectors (Phase C)
# Set USE_MOCK_DATA=true to run offline with zero external keys (315 products, 5 stores, 8 categories)
USE_MOCK_DATA=true
PRIMARY_CONNECTOR=mock

# Amazon Product Advertising API (PA-API v5)
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_REGION=in

# Flipkart Affiliate API
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Generic Merchant Feed Importer (CSV / XML / RSS)
MERCHANT_FEED_URL=
MERCHANT_FEED_PATH=

# Email & Price-Drop Alerts (SMTP with console fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@shoppilot.in

# Telegram Alerts (Phase F)
# Obtain token from @BotFather on Telegram. If empty, falls back to console logging.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ShopPilotAlertsBot
