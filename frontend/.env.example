# ShopPilot Frontend Environment Variables
PORT=3000

# Backend REST API endpoint (FastAPI on Render or localhost)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Canonical Public App URL
NEXT_PUBLIC_APP_URL=https://shoppilot.in

# Admin Key for Protected Telemetry & Review Queue (/admin)
NEXT_PUBLIC_ADMIN_KEY=shoppilot-admin-secret-2026
